# ─────────────────────────────────────────────────────────────
# CloudBrowser Control — portable runtime configuration
# Copy to `.env` and fill in real values. NEVER commit a filled `.env`.
# Every variable below is referenced by code in this repository.
# ─────────────────────────────────────────────────────────────

# --- Core runtime ---
NODE_ENV=development
API_PORT=4000
ENGINE_PORT=8080

# --- Database (PostgreSQL 15+ / Supabase) ---
DATABASE_URL=postgres://cloudbrowser:cloudbrowser@localhost:5432/cloudbrowser
PG_POOL_MAX=10
PGSSLMODE=disable
# Supabase adapter (optional — only needed when using Supabase-managed Postgres)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# --- Service authentication (fail-closed) ---
# The browser engine refuses to start without ENGINE_API_KEY (>= 16 chars).
ENGINE_API_KEY=replace-with-32-char-random-string
# Pepper used to HMAC API keys before storage. Rotating this invalidates all keys.
API_KEY_PEPPER=replace-with-32-char-random-string
# Shared secret for operator <-> engine control calls.
WORKER_SECRET=replace-with-32-char-random-string
# AES-GCM key for encrypted-at-rest credential fields.
ENCRYPTION_KEY=

# --- CORS (allowlist only; never "*") ---
CORS_ALLOWLIST=http://localhost:5173,http://localhost:4000

# --- API gateway limits ---
RATE_LIMIT_PER_MINUTE=120
API_BODY_LIMIT=1mb
ENGINE_REQUEST_TIMEOUT_MS=60000

# --- Browser engine limits ---
ENGINE_URL=http://localhost:8080
MAX_SESSIONS=10
POOL_SIZE=3
DEFAULT_TIMEOUT=30000
SESSION_TTL_MS=300000
CRAWL_MAX_PAGES=50
CRAWL_MAX_DEPTH=3
CRAWL_DELAY_MS=1000
UPLOAD_MAX_BYTES=52428800
DOWNLOAD_MAX_BYTES=104857600
BROWSER_CPU_LIMIT=
BROWSER_MEMORY_LIMIT=
VIDEO_DIR=/tmp/videos
ENFORCE_HTTPS=false
CONFIG_VERSION=dev

# --- Worker / queue ---
POLL_INTERVAL_MS=2000
WORKER_CONCURRENCY=2
LEASE_MS=120000
BACKOFF_BASE_MS=1000
BACKOFF_MAX_MS=300000
REAP_INTERVAL_MS=30000
ENGINE_HEALTH_TIMEOUT_MS=10000

# --- Artifact storage ---
BLOB_READ_WRITE_TOKEN=

# --- Outbound integrations (all optional; features degrade when unset) ---
CAPTCHA_SOLVER_API_KEY=
TWOCAPTCHA_API_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
GITHUB_TOKEN=
GITHUB_OWNER=XTREME-SYSTEMS
GITHUB_REPO=cloudbrowser-control
RAILWAY_API_TOKEN=
VERCEL_API_TOKEN=
# Google Ads / Sheets / Drive sync (only needed when those features are enabled)
HEIR_TRACKING_SHEET_URL=