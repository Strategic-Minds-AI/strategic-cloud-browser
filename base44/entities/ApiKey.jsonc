{
  "name": "ApiKey",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Label for this key (e.g. production, staging)"
    },
    "description": {
      "type": "string",
      "description": "What this key is used for"
    },
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "user",
        "service",
        "vision_cortex"
      ],
      "default": "user",
      "description": "Access role \u2014 determines key prefix and default permissions"
    },
    "external_label": {
      "type": "string",
      "description": "What this API key should be labeled as in external systems (e.g. 'XTREME_SCRAPER_ADMIN_KEY', 'OPENAI_COMPAT_KEY')"
    },
    "key_prefix": {
      "type": "string",
      "description": "First 12 chars for display"
    },
    "key_hash": {
      "type": "string",
      "description": "SHA-256 hashed key for verification"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "last_used": {
      "type": "string",
      "format": "date-time"
    },
    "scopes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Permission scopes (e.g. sessions:read, admin:all)"
    },
    "allowed_functions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Specific backend functions this key can invoke (empty = all allowed for role)"
    },
    "project_id": {
      "type": "string",
      "description": "Project this key is bound to"
    },
    "team_id": {
      "type": "string",
      "description": "Team this key is bound to"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "Expiration timestamp \u2014 expired keys are rejected"
    },
    "rotated_from": {
      "type": "string",
      "description": "ID of the key this was rotated from"
    },
    "created_by": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "key_hash",
    "role"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}