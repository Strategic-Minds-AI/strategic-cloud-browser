{
  "name": "GapResolution",
  "type": "object",
  "properties": {
    "clone_project_id": {
      "type": "string",
      "description": "Reference to the CloneProject"
    },
    "clone_gap_id": {
      "type": "string",
      "description": "Reference to the CloneGap this resolution resolves"
    },
    "gap_type": {
      "type": "string",
      "enum": [
        "database",
        "oauth",
        "server_logic",
        "websocket",
        "firewall",
        "payment",
        "search",
        "realtime",
        "unknown"
      ],
      "description": "The definitively classified gap type"
    },
    "strategy_used": {
      "type": "string",
      "enum": [
        "template",
        "scrape_similar",
        "seed_data",
        "infer_llm"
      ],
      "description": "Which resolution strategy was applied"
    },
    "strategies_attempted": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "All strategies tried, in order"
    },
    "classification_evidence": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Deterministic evidence that proves this gap type"
    },
    "definitive": {
      "type": "boolean",
      "default": true,
      "description": "Whether classification was definitive (100% certain) vs LLM-guessed"
    },
    "confidence_score": {
      "type": "number",
      "default": 0,
      "description": "Confidence in the resolution (0-100)"
    },
    "generated_code": {
      "type": "string",
      "description": "The mock backend code generated for this gap"
    },
    "seed_data": {
      "type": "object",
      "description": "Seeded mock data for database/search gaps"
    },
    "similar_systems_found": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "inferred_schema": {
            "type": "object"
          },
          "relevance": {
            "type": "number"
          }
        }
      },
      "description": "Similar systems scraped for schema inference"
    },
    "template_matched": {
      "type": "string",
      "description": "Template ID from the catalog if template strategy was used"
    },
    "llm_inference": {
      "type": "string",
      "description": "LLM-generated inference if infer_llm strategy was used"
    },
    "industry_detected": {
      "type": "string",
      "description": "Industry detected for the target site"
    },
    "resolution_summary": {
      "type": "string",
      "description": "Human-readable summary of how this gap was resolved"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "classifying",
        "resolving",
        "resolved",
        "failed"
      ],
      "default": "pending"
    },
    "error_message": {
      "type": "string"
    },
    "resolved_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "clone_project_id",
    "clone_gap_id",
    "gap_type",
    "strategy_used",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}