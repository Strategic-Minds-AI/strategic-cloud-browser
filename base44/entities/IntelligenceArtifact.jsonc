{
  "name": "IntelligenceArtifact",
  "type": "object",
  "properties": {
    "seed_id": {
      "type": "string",
      "description": "Reference to the IntelligenceSeed this artifact came from"
    },
    "artifact_type": {
      "type": "string",
      "enum": [
        "insight",
        "strategy",
        "playbook",
        "keyword_cluster",
        "trend_signal",
        "money_trail",
        "elite_motive",
        "competitive_gap",
        "capability_gap",
        "actionable_recommendation",
        "system_learning"
      ],
      "description": "What type of intelligence artifact this is"
    },
    "title": {
      "type": "string"
    },
    "content": {
      "type": "string",
      "description": "The core intelligence content \u2014 insight, strategy, playbook steps, etc."
    },
    "source_url": {
      "type": "string"
    },
    "vision_cortex_analysis": {
      "type": "string",
      "description": "Vision Cortex's deep analysis and interpretation of this artifact"
    },
    "actionable_steps": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Concrete steps the system should take based on this artifact"
    },
    "confidence_score": {
      "type": "number",
      "default": 50,
      "description": "Vision Cortex confidence in this artifact (0-100)"
    },
    "impact_score": {
      "type": "number",
      "default": 50,
      "description": "Potential impact on the system if applied (0-100)"
    },
    "applied_count": {
      "type": "number",
      "default": 0,
      "description": "How many times this artifact has been applied to system operations"
    },
    "effectiveness_score": {
      "type": "number",
      "default": 0,
      "description": "Measured effectiveness after application (0-100)"
    },
    "learned_at": {
      "type": "string",
      "format": "date-time"
    },
    "ingest_batch": {
      "type": "string",
      "description": "Batch ID grouping artifacts from the same ingestion run"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "artifact_type",
    "title",
    "content"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}