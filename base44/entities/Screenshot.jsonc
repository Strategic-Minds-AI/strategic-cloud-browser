{
  "name": "Screenshot",
  "type": "object",
  "properties": {
    "session_id": {
      "type": "string"
    },
    "job_id": {
      "type": "string"
    },
    "step_id": {
      "type": "string"
    },
    "file_url": {
      "type": "string",
      "description": "URL to the stored screenshot image"
    },
    "caption": {
      "type": "string"
    },
    "full_page": {
      "type": "boolean",
      "default": false
    },
    "taken_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "file_url"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}