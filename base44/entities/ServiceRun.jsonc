{
  "name": "ServiceRun",
  "type": "object",
  "description": "One production run of a catalogue service. Every run executes the same nine frozen stages in the same order \u2014 Plan, Discovery, Strategy, Implementation, Validation, QA, Auto-Recommendation, Iteration, Final Results. The run records each stage's one-line result, the brief of record, every piece of evidence with its source and retrieval time, what was iterated and why it stopped, and the three independent assurance verdicts. Written by runServiceWorkflow.",
  "properties": {
    "service_slug": {
      "type": "string",
      "description": "Catalogue service this run belongs to"
    },
    "service_name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "queued",
        "running",
        "assurance",
        "conditional",
        "delivered",
        "blocked",
        "failed"
      ],
      "default": "queued"
    },
    "current_stage": {
      "type": "string",
      "description": "The stage running right now, so the workspace can show progress without a log wall"
    },
    "current_stage_n": {
      "type": "number",
      "default": 0
    },
    "input_sentence": {
      "type": "string",
      "description": "The operator's own words \u2014 the intent of record"
    },
    "enhanced_prompt": {
      "type": "string",
      "description": "The brief the run was actually driven by, after enhancement"
    },
    "prompt_standard": {
      "type": "string",
      "description": "Which standard the enhancement was built against, or that it fell back unenhanced"
    },
    "enhancement": {
      "type": "object",
      "description": "The enhanced brief on the five optimization axes, kept on the run so the result screen can show what the work was measured against",
      "properties": {
        "objective": {
          "type": "string"
        },
        "service_fit": {
          "type": "string"
        },
        "industry_standard": {
          "type": "string"
        },
        "stage_plan": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "stage": {
                "type": "string"
              },
              "does": {
                "type": "string"
              }
            }
          }
        },
        "quality_definition": {
          "type": "string"
        },
        "would_be_wrong": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "automation_notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "acceptance_criteria": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "required_evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "authority_check": {
          "type": "string"
        },
        "refusal_conditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "output_format": {
          "type": "string"
        },
        "done_definition": {
          "type": "string"
        },
        "standards_applied": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "open_questions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "stages": {
      "type": "array",
      "description": "The nine frozen stages, always all present, each with exactly one written result",
      "items": {
        "type": "object",
        "properties": {
          "n": {
            "type": "number"
          },
          "key": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "running",
              "done",
              "skipped",
              "failed",
              "blocked"
            ]
          },
          "result": {
            "type": "string",
            "description": "The one published result this stage produced"
          },
          "skipped_reason": {
            "type": "string",
            "description": "A stage can only be skipped with a stated reason"
          },
          "started_at": {
            "type": "string"
          },
          "finished_at": {
            "type": "string"
          },
          "sub_steps": {
            "type": "array",
            "description": "The service's own numbered steps that land inside this stage, with what each returned",
            "items": {
              "type": "object",
              "properties": {
                "n": {
                  "type": "number"
                },
                "name": {
                  "type": "string"
                },
                "desc": {
                  "type": "string"
                },
                "expected_result": {
                  "type": "string"
                },
                "result": {
                  "type": "string"
                },
                "status": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "default": []
    },
    "steps": {
      "type": "array",
      "description": "The service's own numbered steps as executed, kept for the service pages",
      "items": {
        "type": "object",
        "properties": {
          "n": {
            "type": "number"
          },
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "done",
              "skipped",
              "failed"
            ]
          },
          "result": {
            "type": "string"
          },
          "output": {
            "type": "string"
          }
        }
      },
      "default": []
    },
    "steps_completed": {
      "type": "number",
      "default": 0
    },
    "steps_total": {
      "type": "number",
      "default": 0
    },
    "producer_summary": {
      "type": "string",
      "description": "What the producing agent actually produced"
    },
    "evidence": {
      "type": "array",
      "description": "Every finding with its source and the time it was retrieved. An entry marked claimed_unverified was asserted by the producing agent and has not been mechanically re-fetched \u2014 it is never counted as verified.",
      "items": {
        "type": "object",
        "properties": {
          "step_n": {
            "type": "number"
          },
          "step_name": {
            "type": "string"
          },
          "finding": {
            "type": "string"
          },
          "source_url": {
            "type": "string"
          },
          "retrieved_at": {
            "type": "string"
          },
          "method": {
            "type": "string"
          },
          "hash": {
            "type": "string"
          },
          "verification": {
            "type": "string",
            "enum": [
              "claimed_unverified",
              "verified_live",
              "failed_reverification"
            ]
          }
        }
      },
      "default": []
    },
    "evidence_status": {
      "type": "string",
      "enum": [
        "verified_live",
        "claimed_unverified",
        "absent"
      ],
      "description": "Only verified_live means the evidence was mechanically re-fetched and still matched"
    },
    "unavailable_sources": {
      "type": "array",
      "description": "Every source the run could not reach, with the exact credential, licence or authority that was missing. A blocked source is disclosed, never silently skipped.",
      "items": {
        "type": "object",
        "properties": {
          "step_n": {
            "type": "number"
          },
          "step_name": {
            "type": "string"
          },
          "missing": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      },
      "default": []
    },
    "iterations": {
      "type": "array",
      "description": "Each pass through Validation to Auto-Recommendation, what changed, and the score either side of it",
      "items": {
        "type": "object",
        "properties": {
          "n": {
            "type": "number"
          },
          "entered_because": {
            "type": "string"
          },
          "changed": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "qa_before": {
            "type": "number"
          },
          "qa_after": {
            "type": "number"
          },
          "guardian_allowed": {
            "type": "boolean"
          },
          "result": {
            "type": "string"
          }
        }
      },
      "default": []
    },
    "iteration_stop_reason": {
      "type": "string",
      "description": "Why the loop stopped: QA cleared, or the cap was reached with the score still below the gate"
    },
    "recommendations": {
      "type": "array",
      "description": "What to change next time, derived from this run",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "risks_to_watch": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "decision_questions": {
      "type": "array",
      "description": "Decisions only the operator can make, raised by a stage rather than guessed at",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "block_reason": {
      "type": "string",
      "description": "The one readable line explaining why delivery was refused"
    },
    "assurance": {
      "type": "object",
      "description": "The three independent reviews. Each records the model that produced it so independence stays auditable.",
      "properties": {
        "qa": {
          "type": "object",
          "properties": {
            "agent": {
              "type": "string"
            },
            "model": {
              "type": "string"
            },
            "score": {
              "type": "number"
            },
            "verdict": {
              "type": "string"
            },
            "failed_rules": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "reasons": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "guardian": {
          "type": "object",
          "properties": {
            "agent": {
              "type": "string"
            },
            "model": {
              "type": "string"
            },
            "allowed": {
              "type": "boolean"
            },
            "blocks": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "reasons": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "validator": {
          "type": "object",
          "properties": {
            "agent": {
              "type": "string"
            },
            "model": {
              "type": "string"
            },
            "score": {
              "type": "number"
            },
            "verified": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "unverified": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "notes": {
              "type": "string"
            }
          }
        },
        "model_separation_ok": {
          "type": "boolean",
          "description": "True only when producer, QA, guardian and validator used distinct model families"
        },
        "model_families": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "overall_score": {
      "type": "number",
      "default": 0
    },
    "verdict": {
      "type": "string",
      "enum": [
        "delivered",
        "conditional",
        "blocked",
        "failed"
      ],
      "default": "failed"
    },
    "delivery_allowed": {
      "type": "boolean",
      "default": false,
      "description": "True only for a delivered run: reviews passed, guardian permitted it, and the evidence was mechanically re-verified"
    },
    "monitoring": {
      "type": "object",
      "description": "Signals the dashboard watches for this run",
      "properties": {
        "signals": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "alerts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "deliverables": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "duration_ms": {
      "type": "number",
      "default": 0
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "requested_by_email": {
      "type": "string"
    },
    "error": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "service_slug",
    "service_name",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}