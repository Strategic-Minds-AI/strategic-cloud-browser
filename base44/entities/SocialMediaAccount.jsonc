{
  "name": "SocialMediaAccount",
  "type": "object",
  "properties": {
    "platform": {
      "type": "string",
      "enum": [
        "twitter",
        "facebook",
        "instagram",
        "tiktok",
        "youtube",
        "linkedin",
        "pinterest",
        "reddit",
        "threads",
        "medium",
        "quora",
        "bluesky",
        "mastodon",
        "snapchat",
        "tumblr",
        "discord",
        "telegram",
        "whatsapp",
        "vimeo",
        "dailymotion"
      ],
      "description": "Which social platform this account is on"
    },
    "handle": {
      "type": "string",
      "description": "Username/handle on the platform"
    },
    "profile_url": {
      "type": "string"
    },
    "connected": {
      "type": "boolean",
      "default": false,
      "description": "Whether the account is connected and ready to post"
    },
    "auto_post_enabled": {
      "type": "boolean",
      "default": true
    },
    "posting_frequency": {
      "type": "string",
      "enum": [
        "hourly",
        "daily",
        "twice_daily",
        "weekly",
        "custom"
      ],
      "default": "daily"
    },
    "last_post_at": {
      "type": "string",
      "format": "date-time"
    },
    "posts_count": {
      "type": "number",
      "default": 0
    },
    "followers": {
      "type": "number",
      "default": 0
    },
    "following": {
      "type": "number",
      "default": 0
    },
    "engagement_rate": {
      "type": "number",
      "default": 0
    },
    "growth_rate": {
      "type": "number",
      "default": 0,
      "description": "Follower growth rate %"
    },
    "target_audience_match": {
      "type": "number",
      "default": 0,
      "description": "0-100 how well this platform's audience matches target"
    },
    "content_strategy": {
      "type": "string",
      "description": "Platform-specific content strategy"
    },
    "best_posting_times": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Optimal posting times for this platform"
    },
    "credentials_ref": {
      "type": "string",
      "description": "Reference to stored credentials (never store raw credentials)"
    },
    "api_connection_status": {
      "type": "string",
      "enum": [
        "connected",
        "disconnected",
        "expired",
        "rate_limited",
        "error"
      ],
      "default": "disconnected"
    },
    "auto_created": {
      "type": "boolean",
      "default": false,
      "description": "Whether the factory auto-created this account"
    },
    "connected_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "paused",
        "suspended",
        "error",
        "disconnected"
      ],
      "default": "disconnected"
    }
  },
  "required": [
    "platform",
    "handle",
    "status"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}