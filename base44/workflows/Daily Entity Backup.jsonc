{
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 3 * * *",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "name": "Daily Entity Backup",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "daily_entity_backup",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_backup": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "backupEntityData",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Run entity backup",
            "description": "Export all entities to JSON files"
          }
        }
      }
    ]
  },
  "description": "Exports all critical entity data to stored JSON files every night at 3 AM for disaster recovery"
}