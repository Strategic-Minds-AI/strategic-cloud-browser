{
  "name": "Governance Heartbeat",
  "description": "Canonical 5-minute AutoComplete heartbeat. All system-hardening clocks converge on one leased orchestrator and mandatory repair-integrity postcondition.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/5 * * * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "governance_heartbeat",
      "version": "1.1",
      "namespace": "base44"
    },
    "do": [
      {
        "run_autocomplete_governed": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "runAutoCompleteGovernedCycle",
            "args": { "trigger": "governance_5m" }
          },
          "then": "end",
          "x-base44": {
            "title": "Run governed AutoComplete cycle",
            "description": "Leased audit, validation, repair queue, scoring, bounded healing and mandatory independent-repair integrity postcondition"
          }
        }
      }
    ]
  }
}
