{
  "description": "Polls every 5 minutes for due schedules and runs them",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "schedule_checker",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "check_schedules": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "checkSchedules"
          },
          "then": "end",
          "x-base44": {
            "title": "Check due schedules",
            "description": "Runs any scheduled jobs that are due"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "interval",
      "cron_expression": null,
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": 5,
      "interval_unit": "minutes",
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "name": "Schedule Checker"
}